# Required: Your Shodan API key from https://account.shodan.io/
SHODAN_API_KEY=your_api_key_here

# Optional: Transport mode ("stdio" or "httpStream")
MCP_TRANSPORT=stdio

# Optional: HTTP streaming bind address (only used when MCP_TRANSPORT=httpStream)
MCP_HOST=localhost

# Optional: HTTP streaming port (only used when MCP_TRANSPORT=httpStream)
MCP_PORT=3000

# Optional: HTTP streaming endpoint path (only used when MCP_TRANSPORT=httpStream)
MCP_ENDPOINT=/mcp
